# Copy to .env and fill in. Everything works without the keys (rules-only mode).

# Claude: plain-language scam explanations, 11 SA languages, screenshot reading
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5-5
LLM_EFFORT=low

# Optional: Google Safe Browsing v4 (free key from Google Cloud console)
GOOGLE_SAFE_BROWSING_API_KEY=

# React PWA origins allowed to call the API
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Voice model (any HF audio-classification model with a "fake"/"spoof" label)
VOICE_MODEL_ID=mo-thecreator/Deepfake-audio-detection
TRANSCRIPTION_ENABLED=true
TRANSCRIPTION_MODEL_ID=openai/whisper-base
MAX_AUDIO_SECONDS=60

SEED_DEMO_DATA=true
