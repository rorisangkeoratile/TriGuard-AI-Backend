# Copy to .env and fill in. NEVER commit .env - it holds secret keys (.gitignore already excludes it).
# Everything works without the keys (offline rules, English results).

# --- AI model ------------------------------------------------------------------------------
# Powers: understanding messages in all 11 official languages, answers in the user's language,
# plain-language explanations, screenshot reading and (experimental) voice-note transcription.
# Without a key everything still works, but results are English-only and use the offline rules.
#
# FREE option - Google Gemini: https://aistudio.google.com/apikey -> "Create API key" (Google account only)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
#
# Paid option - Claude: https://console.anthropic.com -> API Keys
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5-5
LLM_EFFORT=low
#
# auto = use whichever key is set (Gemini first) | gemini | anthropic
LLM_PROVIDER=auto

# --- Link reputation (optional) -----------------------------------------------------------
# Free key: Google Cloud console -> enable "Safe Browsing API" -> Credentials -> API key
GOOGLE_SAFE_BROWSING_API_KEY=

# --- Frontend -----------------------------------------------------------------------------
# React PWA origins allowed to call the API (add your deployed URL later)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://localhost:3000
# Dev only: any port on this PC or the local Wi-Fi is also allowed (so the team can test on phones).
# In production, set CORS_ORIGINS to the deployed PWA URL and uncomment this to turn that off:
# CORS_ORIGIN_REGEX=

# --- Voice ---------------------------------------------------------------------------------
# Deepfake voice model: a Hugging Face id, or a local folder such as models/deepfake-audio
VOICE_MODEL_ID=mo-thecreator/Deepfake-audio-detection
# Transcription: Whisper handles English + Afrikaans (~290 MB; whisper-tiny is ~150 MB)
TRANSCRIPTION_ENABLED=true
TRANSCRIPTION_MODEL_ID=openai/whisper-base
# Meta MMS adds isiZulu, isiXhosa, Sepedi and Xitsonga transcription. 3.9 GB download - enable on fast Wi-Fi.
MMS_ENABLED=false
MAX_AUDIO_SECONDS=60

SEED_DEMO_DATA=true
